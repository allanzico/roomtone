# Local Docker run: copy to .env.docker (git-ignored), then `make local-up` and open http://localhost:8088.
# Used with compose.local.yaml: its own project, volumes and port, so it never touches production data and can
# run next to `composer run dev`.
APP_NAME=Roomtone
# php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
APP_URL=http://localhost:8088
LOCAL_PORT=8088

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

# Optional: without them the fake demo still opens, but new guests are not read and no set is built.
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
YOUTUBE_API_KEY=
AI_PROVIDER=claude
AI_PROVIDER_KEY=
AI_MODEL=claude-haiku-5-5

REVERB_APP_ID=roomtone
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
