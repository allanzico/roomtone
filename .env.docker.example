# Settings for `docker compose up` (compose.yaml). Copy to .env.docker (git-ignored).
# php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

# Optional: without them the demo party still plays, but new guests are not read and no set is built.
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
YOUTUBE_API_KEY=
AI_PROVIDER_KEY=
AI_MODEL=claude-haiku-5-5
