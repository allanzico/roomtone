# Roomtone's web server: FrankenPHP (PHP inside Caddy). The same file serves every environment.
#   SERVER_NAME   the site address: a hostname (roomtone.stackyard.io) for HTTPS, or ":8080" for plain HTTP
#   ROOMTONE_TLS  how a hostname gets its certificate (a file in docker/caddy/):
#                   none      plain HTTP (use with SERVER_NAME=:8080; local runs)
#                   internal  Caddy signs it itself: Cloudflare in front, SSL mode "Full"
#                   origin    a Cloudflare Origin Certificate in /certs (SSL mode "Full (strict)")
#                   auto      Let's Encrypt (no Cloudflare proxy in front)
{
	frankenphp
	# Not 80/443: the container runs as www-data, and Docker maps the host's 80/443 to these.
	http_port 8080
	https_port 8443
	# Nothing in the container trusts Caddy's own CA (Cloudflare checks nothing in "Full" mode).
	skip_install_trust
}

(app) {
	root * /app/public
	encode zstd br gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Reverb: browsers connect to ws(s)://<host>/app/<key>; the app publishes events to /apps/<id>/events.
	@reverb path /app/* /apps/*
	reverse_proxy @reverb reverb:8080

	php_server
}

{$SERVER_NAME::8080} {
	import /etc/frankenphp/tls/{$ROOMTONE_TLS:none}.caddy
	import app
}

# Plain HTTP for health checks inside the Docker network (never published).
:8081 {
	import app
}
