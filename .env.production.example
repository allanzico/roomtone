# Copy to .env.production on the server (never commit it), fill in, then see docs/DEPLOY.md.
APP_NAME=Roomtone
APP_ENV=production
APP_DEBUG=false
# php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
# The public address, and the domain Caddy gets a certificate for ("localhost" for a local test).
APP_URL=https://localhost
SERVER_NAME=localhost

LOG_LEVEL=info
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
YOUTUBE_API_KEY=

AI_PROVIDER_KEY=
AI_MODEL=claude-haiku-5-5

# Any values; the key is also built into the JavaScript (the browser needs it to connect).
REVERB_APP_ID=roomtone
REVERB_APP_KEY=
REVERB_APP_SECRET=
