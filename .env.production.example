# Copy to .env.production on the server (never commit it), fill in, then see docs/DEPLOY.md.
APP_NAME=Roomtone
APP_ENV=production
APP_DEBUG=false
# php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
# The public address. Production: Cloudflare (SSL mode "Full") in front of roomtone.stackyard.io.
# For a local run use APP_URL=http://localhost, SERVER_NAME=http://localhost, SESSION_SECURE_COOKIE=false,
# TRUSTED_PROXIES= (empty) and REVERB_PUBLIC_HOST=localhost, REVERB_PUBLIC_PORT=80, REVERB_PUBLIC_SCHEME=http.
APP_URL=https://roomtone.stackyard.io
SERVER_NAME=roomtone.stackyard.io
# Every request comes through Cloudflare: trust its forwarded headers (real visitor IPs for rate limits).
TRUSTED_PROXIES=*

LOG_LEVEL=info
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
YOUTUBE_API_KEY=

AI_PROVIDER_KEY=
AI_MODEL=claude-haiku-5-5

# Any values; the key is also built into the JavaScript (the browser needs it to connect).
REVERB_APP_ID=roomtone
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where browsers reach Reverb (built into the JavaScript: rebuild after changing).
REVERB_PUBLIC_HOST=roomtone.stackyard.io
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
