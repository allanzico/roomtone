# Production settings: copy to .env.production on the server (never commit it), fill in, then ./deploy.sh.
# Used with compose.prod.yaml. See docs/DEPLOY.md.
APP_NAME=Roomtone
# php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
APP_URL=https://roomtone.stackyard.io

# Caddy's site address and certificate mode (docker/Caddyfile). Cloudflare in front, SSL mode "Full": internal.
SERVER_NAME=roomtone.stackyard.io
ROOMTONE_TLS=internal
# Every request comes through Cloudflare: trust its forwarded headers (real visitor IPs for rate limits).
TRUSTED_PROXIES=*

LOG_LEVEL=info
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
YOUTUBE_API_KEY=

AI_PROVIDER=claude
AI_PROVIDER_KEY=
AI_MODEL=claude-haiku-5-5

# Any random values; the key is also built into the JavaScript (the browser needs it to connect).
REVERB_APP_ID=roomtone
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where browsers reach Reverb (built into the JavaScript: rebuild after changing).
REVERB_PUBLIC_HOST=roomtone.stackyard.io
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
